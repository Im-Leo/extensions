{
  "name": "Coffee's Extensions (0.9)",
  "private": true,
  "description": "Paperback v0.9 extensions: AsuraScans, FlameComics, MangaDex, MangaFox, MangaKakalot. Maintained by discord @coffee.lover",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "conformance": "npm run tsc && npm run lint:check && npm run format:check",
    "bundle": "paperback-cli bundle",
    "serve": "paperback-cli serve",
    "dev": "paperback-cli serve --watch",
    "logcat": "paperback-cli logcat",
    "test": "paperback-cli test --noConsole --output ./bundles/tests.json",
    "test:live": "node scripts/test-live.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@paperback/runtime-polyfills": "^1.0.0-alpha.92"
  },
  "devDependencies": {
    "@paperback/toolchain": "^1.0.0-alpha.92",
    "@paperback/types": "^1.0.0-alpha.92",
    "@types/chai": "^5.2.3",
    "chai": "^6.2.2",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "fastest-levenshtein": "^1.0.16",
    "husky": "^9.1.7",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "stemmer": "^2.0.1",
    "typescript": "^7.0.2"
  }
}
